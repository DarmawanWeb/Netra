# NETRA Fleet on a Mac. scripts/local.sh setup copies this to .env and fills the __PLACEHOLDERS__.
COMPOSE_FILE=docker-compose.yml:docker-compose.local.yml

# Address robots and phones on the same Wi-Fi use (also used in Telegram links).
# <name>.local survives DHCP changes; use http://<Mac IP> if the robot cannot resolve .local names.
NETRA_DOMAIN=localhost
NETRA_PUBLIC_URL=__PUBLIC_URL__

POSTGRES_PASSWORD=__POSTGRES_PASSWORD__
GRAFANA_PASSWORD=__GRAFANA_PASSWORD__
BACKUP_KEEP_DAYS=7

NETRA_TZ=Asia/Jakarta
NETRA_LANG=en
NETRA_ADMIN_USER=admin
NETRA_ADMIN_PASSWORD=__ADMIN_PASSWORD__
NETRA_SESSION_HOURS=72

# Optional: Telegram alerts (bot token from @BotFather, group chat ID)
NETRA_TELEGRAM_TOKEN=
NETRA_TELEGRAM_CHAT_ID=

# Final detection model served by the native Ollama (qwen2.5vl:7b needs 16 GB RAM, else qwen2.5vl:3b)
NETRA_AI_MODEL=__AI_MODEL__
NETRA_AI_LANGUAGE=English
