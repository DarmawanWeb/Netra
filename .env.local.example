# NETRA Fleet on a Mac. scripts/local.sh setup copies this to .env and fills the __PLACEHOLDERS__.
COMPOSE_FILE=docker-compose.yml:docker-compose.local.yml

# Address robots and phones on the same network use (also used in Telegram links).
# <name>.local survives DHCP changes; use http://<Mac IP> if the robot cannot resolve .local names.
NETRA_DOMAIN=localhost
NETRA_PUBLIC_URL=__PUBLIC_URL__

# Port on this Mac for the dashboard and the robots (add it to NETRA_PUBLIC_URL when not 80).
# NETRA_LAN_PORT=80
# Behind a Cloudflare Tunnel: add :docker-compose.tunnel.yml to COMPOSE_FILE, point cloudflared at
# http://localhost:8088 and set NETRA_PUBLIC_URL=https://<public hostname>. The LAN port stays open
# for robots on the same network (NETRA_LAN_BIND=127.0.0.1 closes it).
# NETRA_TUNNEL_PORT=8088
# NETRA_LAN_BIND=0.0.0.0
# Next to other stacks on one server (Mac mini with Taksu, Molly, monitoring): NETRA's own block,
# loopback only, robots through the tunnel. scripts/local.sh ports shows what is free.
# NETRA_TUNNEL_PORT=4490
# NETRA_LAN_PORT=4491
# NETRA_LAN_BIND=127.0.0.1

POSTGRES_PASSWORD=__POSTGRES_PASSWORD__
GRAFANA_PASSWORD=__GRAFANA_PASSWORD__
BACKUP_KEEP_DAYS=7

NETRA_TZ=Asia/Jakarta
NETRA_LANG=en
NETRA_ADMIN_USER=admin
NETRA_ADMIN_PASSWORD=__ADMIN_PASSWORD__
NETRA_SESSION_HOURS=72

# Optional: Telegram alerts (bot token from @BotFather, group chat ID)
NETRA_TELEGRAM_TOKEN=
NETRA_TELEGRAM_CHAT_ID=

# Final detection model served by the native Ollama (qwen2.5vl:7b needs 16 GB RAM, else qwen2.5vl:3b)
NETRA_AI_MODEL=__AI_MODEL__
NETRA_AI_LANGUAGE=English
