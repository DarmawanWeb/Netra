# Cloudflare Tunnel + LAN: plain HTTP inside, TLS at Cloudflare. Requests through the tunnel carry
# the visitor address in Cf-Connecting-Ip, which goes to the API as X-Forwarded-For (audit log);
# LAN requests come straight from the robot or phone. Otherwise the same as Caddyfile.local.
{
	servers {
		trusted_proxies static private_ranges
		client_ip_headers Cf-Connecting-Ip X-Forwarded-For
	}
}

:80 {
	encode zstd gzip
	request_body {
		max_size 40MB
	}
	handle /api/* {
		reverse_proxy api:8080 {
			# The visitor (Cf-Connecting-Ip through the tunnel), not cloudflared, for the audit log.
			header_up X-Forwarded-For {client_ip}
		}
	}
	handle /healthz {
		reverse_proxy api:8080
	}
	handle /grafana* {
		reverse_proxy grafana:3000
	}
	handle {
		reverse_proxy web:3000
	}
}
