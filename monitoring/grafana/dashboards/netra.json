{
 "uid": "netra-overview",
 "title": "NETRA Fleet",
 "timezone": "Asia/Jakarta",
 "schemaVersion": 39,
 "refresh": "30s",
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "panels": [
  {
   "type": "stat",
   "title": "Robot online",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(netra_robot_online)"
    }
   ]
  },
  {
   "type": "stat",
   "title": "Anomali masuk (24 jam)",
   "gridPos": {
    "x": 6,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(netra_anomalies_received_total[24h]))"
    }
   ]
  },
  {
   "type": "stat",
   "title": "Validasi tertunda (1 jam)",
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(netra_anomalies_processed_total{status=\"needs_validation\"}[1h]))"
    }
   ]
  },
  {
   "type": "stat",
   "title": "Request API/s",
   "gridPos": {
    "x": 18,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(netra_http_requests_total[5m]))"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Baterai robot",
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "netra_robot_battery_percent",
     "legendFormat": "{{robot}}"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Pesan robot per tipe",
   "gridPos": {
    "x": 12,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (type) (rate(netra_robot_messages_total[5m]))",
     "legendFormat": "{{type}}"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Anomali per status",
   "gridPos": {
    "x": 0,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (status) (increase(netra_anomalies_processed_total[1h]))",
     "legendFormat": "{{status}}"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Latensi AI (p90)",
   "gridPos": {
    "x": 12,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.9, sum by (le) (rate(netra_ai_latency_seconds_bucket[10m])))",
     "legendFormat": "p90"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Error API (5xx/s)",
   "gridPos": {
    "x": 0,
    "y": 20,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (route) (rate(netra_http_requests_total{code=\"5xx\"}[5m]))",
     "legendFormat": "{{route}}"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Orang terdeteksi (rata-rata 5 menit)",
   "gridPos": {
    "x": 12,
    "y": 20,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "timescale"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "rawSql": "SELECT time_bucket('5 minutes', ts) AS time, robot_id AS metric, avg(people) FROM telemetry WHERE $__timeFilter(ts) GROUP BY 1, 2 ORDER BY 1",
     "format": "time_series",
     "rawQuery": true,
     "editorMode": "code"
    }
   ]
  }
 ],
 "tags": [
  "netra"
 ]
}