# Domain pointing at this VPS (Caddy fetches the TLS certificate)
NETRA_DOMAIN=netra.example.com
POSTGRES_PASSWORD=change-me-long-random
GRAFANA_PASSWORD=change-me
BACKUP_KEEP_DAYS=14

# Images: built by the be/fe CI (ghcr.io/<owner>/netra-api|netra-ai|netra-web), or locally with --build
REGISTRY=ghcr.io/darmawanweb
TAG=main

NETRA_TZ=Asia/Jakarta
# Language of Telegram captions (en | id); the dashboard has its own switch
NETRA_LANG=en
NETRA_ADMIN_USER=admin
NETRA_ADMIN_PASSWORD=change-me
NETRA_SESSION_HOURS=72
NETRA_TELEGRAM_TOKEN=
NETRA_TELEGRAM_CHAT_ID=

# Final detection model on Ollama (GPU strongly recommended for 7B models)
NETRA_AI_MODEL=qwen2.5vl:7b
NETRA_AI_LANGUAGE=English
