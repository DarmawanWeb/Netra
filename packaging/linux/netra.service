[Unit]
Description=NETRA patrol command center
Documentation=https://github.com/DarmawanWeb/Netra/blob/main/INSTALL.md
After=network-online.target postgresql.service
Wants=network-online.target postgresql.service

[Service]
Type=simple
User=netra
Group=netra
EnvironmentFile=/etc/netra/netra.env
ExecStart=/usr/bin/netra serve
WorkingDirectory=/var/lib/netra
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
LimitNOFILE=65536
# Ports below 1024 (NETRA_ADDR=:80 or :443) without running as root
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/netra

[Install]
WantedBy=multi-user.target
