# NETRA configuration (systemd reads it; `systemctl restart netra` after a change).
# Every setting: https://github.com/DarmawanWeb/netra-fleet-be/blob/main/docs/configuration.md

# Address and port of the dashboard and of the robots
NETRA_ADDR=:8080
# Address robots and phones use to reach this server, e.g. http://192.168.1.10:8080
NETRA_PUBLIC_URL=
NETRA_TZ=Asia/Jakarta
# Language of Telegram captions: en or id
NETRA_LANG=id

NETRA_DATA_DIR=/var/lib/netra
# Written by the installer: the local PostgreSQL through its socket, as the system user netra
NETRA_DATABASE_URL=

# The license file (or install it in the dashboard: Settings > License)
NETRA_LICENSE_FILE=/etc/netra/license.lic

# HTTPS: self-signed (browsers ask to trust it once), or a certificate of your own
# NETRA_TLS=self-signed
# NETRA_TLS_CERT=/etc/netra/tls/cert.pem
# NETRA_TLS_KEY=/etc/netra/tls/key.pem

# Final AI detection on Ollama (module ai.final), e.g. http://localhost:11434
# NETRA_OLLAMA_URL=
# NETRA_AI_MODEL=qwen2.5vl:7b
# NETRA_AI_LANGUAGE=Indonesian

# Daily database backups in /var/lib/netra/backups
NETRA_BACKUP_KEEP_DAYS=14
NETRA_BACKUP_AT=02:30

# Telegram alerts (module alerts.telegram)
# NETRA_TELEGRAM_TOKEN=
# NETRA_TELEGRAM_CHAT_ID=
