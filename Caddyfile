{$NETRA_DOMAIN} {
	encode zstd gzip
	request_body {
		max_size 40MB
	}
	handle /api/* {
		reverse_proxy api:8080
	}
	handle /healthz {
		reverse_proxy api:8080
	}
	handle /grafana* {
		reverse_proxy grafana:3000
	}
	handle {
		reverse_proxy web:3000
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
